# Local Ollama (default)
LLM_PROVIDER=openai
# localhost here is for running on the host (`make run-local`). Inside `make run` (Docker), the
# pipeline container overrides this to http://ollama:11434/v1 via compose.yaml's `environment:` —
# from inside a container, localhost is the container itself, not the ollama service.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e2b
SOURCE=live

# How many works `make run` (the real, live run) processes — read by the Dockerfile CMD's
# `--limit ${RUN_LIMIT:-12}` (and `make run-local`'s equivalent), not by Settings. 12 keeps a run
# against a slow local model finishing in reasonable time while still clearing the challenge's
# 10-work minimum. Raise it to process more, or remove it (and the --limit flag) to run the
# whole live catalog.
# RUN_LIMIT=12

# OpenAI example
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Fully offline (no network, no GPU): deterministic mock LLM + committed PDF fixtures.
# This is what `make test` (and `make run-offline`) run with.
# LLM_PROVIDER=mock
# SOURCE=fixtures

# Scale knobs (defaults shown) — see orchestrator/engine.py + pipeline.py for how each is used.
# DOWNLOAD_CONCURRENCY=4     # semaphore around network I/O (scrape/download)
# LLM_CONCURRENCY=2          # semaphore around LLM calls (describe/translate)
# QUEUE_MAXSIZE=16           # bounded queue between scrape and the download worker pool (backpressure)
# MAX_RETRIES=3              # retries per stage call, exponential backoff + full jitter
# RETRY_BASE_DELAY_S=0.5     # base delay (seconds) for the backoff above
# REQUEST_TIMEOUT_S=120      # HTTP/LLM call timeout; raise for slow local models (Ollama/CPU) — 30s is plenty for fast APIs
# MIN_BOOKS=10               # the challenge's minimum catalog size

# Data layer root (bronze/silver/gold live under <DATA_DIR>/{raw,staging,curated}).
# DATA_DIR=./data
