# Local Ollama (default)
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e2b
SOURCE=live

# OpenAI example
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Fully offline (no network, no GPU): deterministic mock LLM + committed PDF fixtures.
# This is what `make test` (and `make run-offline`) run with.
# LLM_PROVIDER=mock
# SOURCE=fixtures

# Scale knobs (defaults shown) — see orchestrator/engine.py + pipeline.py for how each is used.
# DOWNLOAD_CONCURRENCY=4     # semaphore around network I/O (scrape/download)
# LLM_CONCURRENCY=2          # semaphore around LLM calls (describe/translate)
# QUEUE_MAXSIZE=16           # bounded queue between scrape and the download worker pool (backpressure)
# MAX_RETRIES=3              # retries per stage call, exponential backoff + full jitter
# RETRY_BASE_DELAY_S=0.5     # base delay (seconds) for the backoff above
# REQUEST_TIMEOUT_S=30       # HTTP/LLM call timeout
# MIN_BOOKS=10               # the challenge's minimum catalog size

# Data layer root (bronze/silver/gold live under <DATA_DIR>/{raw,staging,curated}).
# DATA_DIR=./data
