# Local Ollama (default)
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e2b
SOURCE=live

# OpenAI example
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Fully offline (no network, no GPU): deterministic mock LLM + committed PDF fixtures.
# This is what `make test` runs with.
# LLM_PROVIDER=mock
# SOURCE=fixtures
